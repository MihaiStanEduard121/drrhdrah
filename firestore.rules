rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Channels Collection
    match /channels/{channelId} {
      // Anyone can read channels in list or get operations
      allow read: if true;

      // All modifications are strictly handled via secure Server API (no direct client writes)
      allow write: if false;
    }
  }
}
